{
  "name": "devops",
  "displayName": "DevOps",
  "version": "1.0.1",
  "description": "Inspect local containers and Kubernetes resources through a shared operations workspace.",
  "author": {
    "name": "Localix"
  },
  "license": "MIT",
  "apiVersion": 1,
  "category": "development",
  "tags": ["docker", "kubernetes", "containers", "logs"],
  "icon": "./icon.svg",
  "screenshots": [
    {
      "path": "./screenshots/containers.png",
      "caption": "A running container and its live logs"
    },
    {
      "path": "./screenshots/pod-logs.png",
      "caption": "A pod’s readiness and container logs"
    }
  ],
  "surfaces": ["agent", "workbench"],
  "backend": "./backend/index.ts",
  "fileAssociations": [
    {
      "ext": ["dockerfile"],
      "name": "Dockerfile",
      "description": "Docker image build file",
      "role": "Editor"
    },
    {
      "ext": ["compose.yaml", "compose.yml", "docker-compose.yaml", "docker-compose.yml"],
      "name": "Docker Compose file",
      "description": "Docker Compose services",
      "role": "Editor"
    }
  ]
}
