{
  "$schema": "https://localix.ai/schemas/mini-app-marketplace/v3.json",
  "schema": 3,
  "name": "localix",
  "owner": {
    "name": "Localix"
  },
  "metadata": {
    "description": "Localix's own mini apps."
  },
  "apps": [
    {
      "name": "api",
      "source": "./mini-apps/api",
      "suggestFor": {
        "files": [
          "*.http",
          "*.rest",
          "openapi.yaml",
          "openapi.yml",
          "openapi.json",
          "swagger.yaml",
          "swagger.json",
          "*.postman_collection.json",
          "*.har",
          "*.request.json"
        ],
        "dependencies": [
          "express",
          "fastify",
          "hono",
          "koa",
          "@nestjs/core",
          "elysia"
        ]
      }
    },
    {
      "name": "battleship",
      "source": "./mini-apps/battleship"
    },
    {
      "name": "checkers",
      "source": "./mini-apps/checkers"
    },
    {
      "name": "chess",
      "source": "./mini-apps/chess",
      "featured": true
    },
    {
      "name": "code-graph",
      "source": "./mini-apps/code-graph",
      "featured": true
    },
    {
      "name": "database",
      "source": "./mini-apps/database",
      "featured": true,
      "suggestFor": {
        "files": [
          "*.sql",
          "*.sqlite",
          "*.sqlite3",
          "*.db"
        ],
        "dependencies": [
          "pg",
          "postgres",
          "mysql2",
          "mysql",
          "better-sqlite3",
          "sqlite3",
          "mssql",
          "tedious",
          "mongodb",
          "mongoose",
          "redis",
          "ioredis",
          "@elastic/elasticsearch",
          "prisma",
          "@prisma/client",
          "drizzle-orm",
          "kysely",
          "typeorm",
          "sequelize",
          "knex"
        ]
      }
    },
    {
      "name": "devops",
      "source": "./mini-apps/devops",
      "suggestFor": {
        "files": [
          "Dockerfile",
          "*.dockerfile",
          "compose.yaml",
          "compose.yml",
          "docker-compose.yaml",
          "docker-compose.yml",
          "Chart.yaml",
          "kustomization.yaml",
          "kustomization.yml",
          "skaffold.yaml"
        ],
        "dependencies": [
          "dockerode",
          "@kubernetes/client-node"
        ]
      }
    },
    {
      "name": "documents",
      "source": "./mini-apps/documents",
      "installByDefault": true,
      "suggestFor": {
        "files": [
          "*.docx",
          "*.doc",
          "*.odt",
          "*.pptx",
          "*.xlsx",
          "*.xls",
          "*.xlsm",
          "*.xlsb",
          "*.csv",
          "*.pdf"
        ],
        "dependencies": [
          "exceljs",
          "xlsx",
          "docx",
          "pptxgenjs",
          "pdf-lib",
          "pdfkit"
        ]
      }
    },
    {
      "name": "game-2048",
      "source": "./mini-apps/game-2048"
    },
    {
      "name": "git-workspace",
      "source": "./mini-apps/git-workspace",
      "installByDefault": true
    },
    {
      "name": "kanban",
      "source": "./mini-apps/kanban",
      "featured": true,
      "installByDefault": true
    },
    {
      "name": "learning",
      "source": "./mini-apps/learning",
      "suggestFor": {
        "files": [
          "course.json",
          "*.localix-course"
        ]
      }
    },
    {
      "name": "project-space",
      "source": "./mini-apps/project-space",
      "featured": true,
      "installByDefault": true
    },
    {
      "name": "reader",
      "source": "./mini-apps/reader",
      "suggestFor": {
        "files": [
          "*.epub",
          "*.mobi",
          "*.azw3",
          "*.fb2",
          "*.cbz"
        ]
      }
    },
    {
      "name": "resume",
      "source": "./mini-apps/resume"
    },
    {
      "name": "rock-paper-scissors",
      "source": "./mini-apps/rock-paper-scissors"
    },
    {
      "name": "snake",
      "source": "./mini-apps/snake"
    },
    {
      "name": "tic-tac-toe",
      "source": "./mini-apps/tic-tac-toe"
    },
    {
      "name": "trading",
      "source": "./mini-apps/trading"
    }
  ],
  "collections": [
    {
      "id": "play-with-the-agent",
      "title": "Play with the agent",
      "subtitle": "Board and puzzle games the agent plays against you",
      "style": "row",
      "items": [
        "chess",
        "checkers",
        "battleship",
        "game-2048"
      ]
    },
    {
      "id": "work-with-data",
      "title": "Work with data",
      "subtitle": "Query databases and APIs, and read and write documents",
      "style": "row",
      "items": [
        "database",
        "api",
        "documents",
        "plugin:supabase@claude-plugins-official",
        "plugin:neon@claude-plugins-official",
        "plugin:mongodb@claude-plugins-official",
        "plugin:duckdb-skills@claude-plugins-official"
      ]
    }
  ]
}
