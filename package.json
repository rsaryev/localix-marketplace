{
  "name": "localix-marketplace",
  "private": true,
  "description": "Localix's own Claude Code plugins and mini apps, installed through Localix's marketplace and mini app catalog like any other.",
  "license": "MIT",
  "type": "module",
  "workspaces": ["mini-apps/*", "plugins/*"],
  "localix": {
    "kit": "latest"
  },
  "scripts": {
    "postinstall": "bun scripts/kit.ts",
    "kit": "bun scripts/kit.ts",
    "check": "bun scripts/check.ts",
    "test:plugins": "bun test --cwd plugins/mini-app-authoring src",
    "test:scripts": "bun test ./scripts",
    "pack": "bun scripts/pack.ts"
  }
}
